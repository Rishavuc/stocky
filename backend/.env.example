# ========================================================
# INVESTOR'S EYE — Environment Configuration (.env)
# ========================================================

# Application Mode & Port
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true

# Frontend origin (CORS + Kite callback redirect). Extra origins: comma-separated.
FRONTEND_URL=
CORS_ORIGINS=
# Serve the static frontend from the repo root (default: on in dev, off in production)
# SERVE_FRONTEND=true

# Database (Default: local SQLite database; for production use PostgreSQL/TimescaleDB)
DATABASE_URL=sqlite+aiosqlite:///./investors_eye.db
# PRODUCTION EXAMPLE: postgresql+asyncpg://postgres:password@localhost:5432/investorseye

# Redis Cache & Message Broker (Optional in dev, falls back to in-memory bus)
REDIS_URL=redis://localhost:6379/0

# JWT signing key. Production refuses to start with a default or <32-char value.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=dev_secret_key_change_in_production_investors_eye_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- External Provider Credentials (Optional / Generate Request) ---
# Indian Broker Integrations (Read-only sync)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
KITE_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ANGELONE_SMARTAPI_KEY=

# Market Data Feeds (Yahoo Finance / AlphaVantage / CoinGecko)
ALPHAVANTAGE_API_KEY=
COINGECKO_API_KEY=

# Notification Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Shared 1-click demo login (demo@investorseye.com / demo). Public by design.
DEMO_USERS_ENABLED=true

# Who may change the server-wide Kite session or view the Binance account.
# Comma-separated user ids (see /v1/auth/me). Empty = nobody.
ADMIN_USER_IDS=
# Accept Zerodha's redirect to /kite/callback (default: on in dev, off in prod).
# Turn on briefly when the admin re-authorizes Kite, then off again.
# KITE_CALLBACK_ENABLED=false
# Read the client IP from the rightmost X-Forwarded-For entry (default: on when RENDER=true).
# TRUST_PROXY_HEADERS=false
