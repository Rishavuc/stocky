# Local single-host execution. scripts/setup.sh writes DATABASE_URL for its database.
# PostgreSQL is the supported deployment database; SQLite is only a development/test fallback.
DATABASE_URL=postgresql+psycopg://eye:CHANGE_ME@127.0.0.1:55432/investorseye
POSTGRES_PASSWORD=CHANGE_ME
APP_HOST=127.0.0.1
APP_PORT=8000
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Optional authenticated current-market data. Never required for replay.
KITE_API_KEY=
KITE_ACCESS_TOKEN=

PUBLIC_BASE_URL=http://127.0.0.1:8000
# For production, provide a Fernet key through the host secret store and back it up.
# EYE_ENCRYPTION_KEY=
AUTH_SMTP_HOST=
AUTH_SMTP_PORT=587
AUTH_SMTP_USER=
AUTH_SMTP_PASSWORD=
AUTH_SMTP_FROM=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
