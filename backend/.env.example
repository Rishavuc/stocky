# ========================================================
# INVESTOR'S EYE — Environment Configuration (.env)
# ========================================================

# Application Mode & Port
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true

# Database (Default: local SQLite database; for production use PostgreSQL/TimescaleDB)
DATABASE_URL=sqlite+aiosqlite:///./investors_eye.db
# PRODUCTION EXAMPLE: postgresql+asyncpg://postgres:password@localhost:5432/investorseye

# Redis Cache & Message Broker (Optional in dev, falls back to in-memory bus)
REDIS_URL=redis://localhost:6379/0

# JWT Auth & Envelope Encryption Key
JWT_SECRET_KEY=dev_secret_key_change_in_production_investors_eye_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- External Provider Credentials (Optional / Generate Request) ---
# Indian Broker Integrations (Read-only sync)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
ANGELONE_SMARTAPI_KEY=

# Market Data Feeds (Yahoo Finance / AlphaVantage / CoinGecko)
ALPHAVANTAGE_API_KEY=
COINGECKO_API_KEY=

# Notification Channels
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
