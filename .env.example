# ========================================================
# INVESTOR'S EYE — Environment Configuration Template (.env)
# Copy this file to .env and insert your API credentials
# ========================================================

# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
DEBUG=true

# Database (Default: local SQLite database; for production use PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./investors_eye.db

# JWT Auth Secret Key
JWT_SECRET_KEY=dev_secret_key_change_in_production_investors_eye_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ========================================================
# BROKER & EXCHANGE LIVE FEEDS (Optional / Configurable)
# ========================================================

# Zerodha Kite Connect (Indian Equities & F&O)
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_ACCESS_TOKEN=

# Binance Exchange (Crypto Live Feeds & Spot Execution)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_secret_key_here

# Redis Cache (Optional in dev, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0
